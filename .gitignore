# Secrets: never commit
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
.venv/
venv/

# Data: raw pulls and form exports stay local
data/raw/
data/form/
*.csv

# Frontend
node_modules/
dist/
.next/

# Mock summary cache is rebuilt by tests; the real one is committed so deploys need no LLM calls
data/mock/*.summaries.json
data/export/stories.json

# fastembed model cache (downloaded at build time on Render)
.fastembed_cache/
