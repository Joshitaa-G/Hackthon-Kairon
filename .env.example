# Copy to .env and fill in. Never commit .env.

# Stack Exchange API key (free, raises quota from ~300 to 10,000 requests/day)
# Register an app at https://stackapps.com/apps/oauth/register
SE_API_KEY=

# LLM for llm_json(). Any OpenAI-compatible provider: set base URL, key and model.
# Check each provider's dashboard for current model names and free limits.
#   Groq:      https://api.groq.com/openai/v1   model e.g. llama-3.3-70b-versatile
#   Cerebras:  https://api.cerebras.ai/v1       model e.g. llama-3.3-70b
#   Backboard: see Backboard.io docs for its base URL and model names
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Optional second provider for the report summary (falls back to the LLM_* values above)
REPORT_LLM_BASE_URL=
REPORT_LLM_API_KEY=
REPORT_LLM_MODEL=

# Frontend origin allowed by CORS
ALLOWED_ORIGIN=http://localhost:5173

# Small model for /match only (falls back to LLM_MODEL). e.g. Cerebras llama3.1-8b
MATCH_LLM_MODEL=

# Which database the API reads, and how many stories each report uses
DB_PATH=data/been_there.sqlite
RETRIEVE_K=40

# 1 = offline mock LLM (tests, frontend work before keys exist)
LLM_MOCK=0
RATE_LIMIT=30/minute
