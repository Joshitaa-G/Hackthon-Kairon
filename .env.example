# Copy to .env and fill in. Never commit .env.

# Stack Exchange API key (free, raises quota from ~300 to 10,000 requests/day)
# Register an app at https://stackapps.com/apps/oauth/register
SE_API_KEY=

# LLM for llm_json(). Any OpenAI-compatible provider: set base URL, key and model.
# Groq free limits are PER MODEL (1,000 requests/day, 8,000 tokens/min), so we spread
# work across models. Check names with: python scripts/extract.py --models
#   Groq:      https://api.groq.com/openai/v1   models: qwen/qwen3.8-27b, openai/gpt-oss-20b
#   Cerebras:  https://api.cerebras.ai/v1
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b

# Report summary in the app (~1 call per decision type, saved to disk). See docs/token_budget.md
REPORT_LLM_BASE_URL=https://api.groq.com/openai/v1
REPORT_LLM_API_KEY=
REPORT_LLM_MODEL=openai/gpt-oss-120b

# Small model for /match only (falls back to LLM_MODEL); separate quota from extraction
MATCH_LLM_MODEL=openai/gpt-oss-20b

# Which database the API reads, and how many stories each report uses
DB_PATH=data/been_there.sqlite
RETRIEVE_K=40

# 1 = offline mock LLM (tests, frontend work before keys exist)
LLM_MOCK=0
RATE_LIMIT=30/minute

# Frontend origin allowed by CORS
ALLOWED_ORIGIN=http://localhost:5173
